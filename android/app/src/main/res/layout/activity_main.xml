<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="32dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- Sta in basso a sinistra, piccolo e mezzo trasparente: chi lavora in
         sala sa dov'e', chi legge il menu non lo nota. Se lo preme un cliente
         non succede niente di male, al massimo un controllo in piu'. -->
    <ImageButton
        android:id="@+id/aggiorna"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:alpha="0.35"
        android:background="@drawable/sfondo_tondo"
        android:contentDescription="@string/aggiorna_ora"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_aggiorna" />

    <TextView
        android:id="@+id/banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="#CC000000"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:text="@string/updated_banner"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

</FrameLayout>
